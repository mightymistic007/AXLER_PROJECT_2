# Redpanda / Kafka Connection
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_INPUT_TOPIC=telemetry.clean

# MinIO / S3 Lakehouse Storage Engine
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password123
MINIO_BUCKET=lakehouse

# Apache Iceberg Catalog Configuration
ICEBERG_CATALOG_NAME=lakehouse_catalog
ICEBERG_CATALOG_URI=sqlite:////tmp/iceberg_catalog.db
ICEBERG_TABLE=lakehouse.orders
